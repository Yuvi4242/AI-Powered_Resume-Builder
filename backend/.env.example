# AI Resume Builder - Backend Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://your-frontend-domain.vercel.app

# MongoDB Configuration
# Get your connection string from MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai_resume

# Authentication (JWT)
# Generate a strong secret (e.g., openssl rand -base64 32)
JWT_SECRET=your_super_secure_jwt_secret_here
JWT_EXPIRE=30d

# Email Service (SMTP / OTP)
# Example for Gmail: use App Passwords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# AI Service (Groq)
# Get your API key from console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
